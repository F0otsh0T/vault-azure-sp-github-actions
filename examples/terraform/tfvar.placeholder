################################################
# AZURE

azure_tenant_id       = "" # Azure Tenant ID
azure_subscription_id = "" # Azure Subscription ID
azure_user_object_id  = "" # Azure User Object ID - Obfuscate when not in use
azure_environment     = "AzurePublicCloud"                     # Azure Environment
azure_region          = "westus2"                              # Azure Region

################################################
# VAULT

vault_url        = "https://{{FQDN}}:8200"
# vault_root_token = ""
vault_namespace  = "admin"

################################################
# GITHUB

github_pat_token      = "ghp_BLAH"                             # GitHub Personal Access Token or `GITHUB_TOKEN`
github_bound_audience = "https://github.com/BLAH"              # GitHub Bound Audience - "https://github.com/{{ORG}}" or "https://github.com/{{USER}}"

